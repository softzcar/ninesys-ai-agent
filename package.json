{
  "name": "ninesys-ai-agent",
  "version": "0.1.0",
  "description": "Capa Node reutilizable del ecosistema Ninesys: cliente MCP + puente a Gemini que corre el bucle de tool-use. Usable como librería (apps Node) o como servicio HTTP /chat (SPAs sin backend, como app_multi).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "pm2": "pm2 start ecosystem.config.cjs",
    "pm2-logs": "pm2 logs ninesys-ai-agent"
  },
  "keywords": [
    "mcp",
    "ninesys",
    "gemini",
    "ia",
    "agent"
  ],
  "author": "Ninesys",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.48.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
