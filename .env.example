# ---------------------------------------------------------------------------
# ninesys-ai-agent — configuración (modo servicio HTTP)
# ---------------------------------------------------------------------------

# Puerto local del servicio /chat (Nginx/OLS hace el reverse-proxy HTTPS).
PORT=3200

# ---- Conexión al MCP ----
# URL del endpoint MCP. En el mismo VPS se puede usar localhost.
#   Dev (local):  http://127.0.0.1:3100/mcp
#   Dev (público): https://mcp.nineteengreen.com/mcp
MCP_URL=http://127.0.0.1:3100/mcp
# Token Bearer con el que este agente se autentica ANTE el MCP (uno de los
# MCP_CLIENT_TOKENS del servidor MCP).
MCP_TOKEN=

# ---- Gemini ----
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
# System prompt por defecto del agente (se puede sobreescribir por petición).
AI_SYSTEM_PROMPT=Eres el asistente interno de Ninesys. Responde con datos reales obtenidos mediante las herramientas disponibles; si una herramienta no devuelve datos, dilo con claridad. Sé breve y directo.

# Máximo de iteraciones del bucle de tool-use por consulta.
AI_MAX_STEPS=6

# ---- Auth del propio servicio /chat ----
# Tokens Bearer de las apps que llaman a ESTE agente (formato nombre:token,...).
AGENT_CLIENT_TOKENS=
# Orígenes CORS permitidos (coma-separados). Ej: https://app.nineteengreen.com
AGENT_CORS_ORIGINS=

LOG_LEVEL=info
